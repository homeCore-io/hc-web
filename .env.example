# hc-web + go2rtc stack config. Copy to .env:  cp .env.example .env

# homeCore appliance API base — the box already running hc-core.
# Must be reachable from the hc-web container.
HOMECORE_URL=http://10.0.10.150:8080

# Host port hc-web is published on (the URL you open in a browser / Fully Kiosk).
HC_WEB_PORT=3000
